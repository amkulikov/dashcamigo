{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "vite": true,
    "entry": [
        "scripts/*.mjs",
        "src/parsers/__fixtures__/**/build-*.mjs",
        "public/sw.js",
        "public/privacy.js"
    ],
    "project": [
